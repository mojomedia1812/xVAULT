<?xml version="1.0" encoding="UTF-8"?>
<addons><addon id="plugin.video.xvault" version="2026.10.29.2" name="[B]xVAULT[/B]" provider-name="xVAULT">
    <requires>
        <import addon="xbmc.python" version="3.0.0" />
        <import addon="script.module.requests" optional="true" />
        <import addon="script.module.download-m3u8" optional="true" />
        <import addon="script.module.six" optional="true" />
        <import addon="script.module.pyaes" optional="true" />
        <import addon="script.module.pyqrcode" optional="true" />
        <import addon="script.module.infotagger" optional="true" />
        <import addon="script.module.resolveurl" version="5.1.100" optional="true" />
        <import addon="inputstream.adaptive" optional="true" />
        <import addon="inputstream.ffmpegdirect" optional="true" />
        <import addon="inputstream.rtmp" optional="true" />
        <import addon="plugin.video.youtube" optional="true" />
        <import addon="visualization.xvault" optional="true" />

        <import addon="script.module.pydevd" optional="true" />
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>audio video</provides>
    </extension>
    <extension point="xbmc.service" library="service.py" start="startup" />
    <extension point="xbmc.addon.metadata">
        <summary lang="de_DE">Filme, Serien, LiveTV und Radio durchsuchen und wiedergeben</summary>
        <summary lang="en_GB">Browse and play movies, TV shows, live TV and radio</summary>
        <description lang="de_DE">xVAULT ist ein Kodi-Add-on zum Suchen, Verwalten und Wiedergeben von Filmen, Serien, LiveTV und deutschen Radiosendern mit Quellenwahl, Favoriten, Wiedergabestatus und optionaler Synchronisation. Die offizielle Repository- und Updateadresse ist https://xvault.repowork.de/. Support kann nur für Installationen aus dem offiziellen xVAULT-Repository geleistet werden; Pakete aus fremden Repositories, Reuploads oder veränderte Versionen lassen sich nicht zuverlässig prüfen.</description>
        <description lang="en_GB">xVAULT is a Kodi add-on for browsing and playing movies, TV shows, live TV and German radio stations with source selection, favorites, watched status and optional synchronization. The official repository and update address is https://xvault.repowork.de/. Support is available only for installations from the official xVAULT repository; packages from third-party repositories, reuploads or modified builds cannot be verified reliably.</description>
        <website>https://xvault.repowork.de/</website>
        <platform>all</platform>
        <assets>
			<icon>resources/icon.png</icon>
			<fanart>resources/fanart.png</fanart>
			<banner>resources/media/banner.png</banner>
		</assets>
    </extension>
</addon><addon id="repository.xvault" name="xVAULT Repository" provider-name="xVAULT" version="1.0.3">
    <extension point="xbmc.addon.repository" name="xVAULT Repository">
        <dir>
            <info compressed="false">https://xvault.repowork.de/addons.xml</info>
            <checksum>https://xvault.repowork.de/addons.xml.md5</checksum>
            <datadir zip="true">https://xvault.repowork.de/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="de_DE">Offizielles xVAULT Kodi-Repository</summary>
        <summary lang="en_GB">Official xVAULT Kodi repository</summary>
        <description lang="de_DE">Stellt xVAULT-Updates ueber Kodi bereit.</description>
        <description lang="en_GB">Provides xVAULT updates through Kodi.</description>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon><addon id="visualization.xvault" version="22.0.1" name="xVAULT-Visuals" provider-name="xVAULT">
  <requires>
    <import addon="kodi.binary.global.main" minversion="2.0.3" version="2.0.3" />
    <import addon="kodi.binary.instance.visualization" minversion="5.0.0" version="5.0.0" />
  </requires>
  <extension point="xbmc.player.musicviz" library_windows="visualization.xvault.dll" />
  <extension point="xbmc.addon.metadata">
    <summary lang="de_DE">Sieben Musikwelten mit nativer Preset-Auswahl</summary>
    <summary lang="en_GB">Pastel audio currents with a sky-blue zero line</summary>
    <description lang="de_DE">Eigenständige native Musikvisualisierung: Bass in Rosé, Mitten in Mint, Höhen in Lavendel. Bildschirmauflösung und geglättete Linien, ohne Shadertoy.</description>
    <platform>windows-x86_64</platform>
    <license>GPL-2.0-or-later</license>
    <assets><icon>resources/icon.png</icon></assets>
  </extension>
</addon></addons>
